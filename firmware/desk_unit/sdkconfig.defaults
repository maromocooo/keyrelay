CONFIG_IDF_TARGET="esp32s3"
# ログはUART0（ボードの「COM」側USB-C）に出す。ネイティブUSBはYubiKey用
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# ---- BLE（NimBLE） ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
# NimBLE + USB でアプリが大きくなるので1.5MBのアプリ領域に
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# app_main でUSB列挙と状態ログを行うので少し余裕を持たせる
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# ---- 省電力（ESP-IDF examples/bluetooth/nimble/power_save/sdkconfig.40m.esp32s3 に準拠） ----
# Freenove / XIAO ESP32S3 には32kHz水晶がないので、BLEの低電力クロックはメイン水晶(40MHz)を使い、
# ライトスリープ中もメイン水晶を止めない（BLE接続を維持できる。ライトスリープ電流は約3mA）
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_ESP_PHY_MAC_BB_PD=y
