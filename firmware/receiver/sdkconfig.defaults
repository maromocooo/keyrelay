CONFIG_IDF_TARGET="esp32s3"
# ログはUART0（ボードの「COM」側USB-C）に出す。ネイティブUSBはMacへのFIDOデバイス用
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# TinyUSB: 標準のHIDクラスは使わない（FIDO・OTPキーボードとも自前ドライバー hid_dev.c）
CONFIG_TINYUSB_HID_COUNT=0
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_MSC_ENABLED=n
# 1ms tick（USBの待ち処理を細かく）
CONFIG_FREERTOS_HZ=1000
# ---- BLE（NimBLE） ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
# NimBLE + USB でアプリが大きくなるので1.5MBのアプリ領域に
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Link protocol v2: X25519 for forward secrecy (yd_sec)
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
